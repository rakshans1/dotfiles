#!/bin/bash
# Generate one Raycast script command per repo, so each repo is reachable by
# name straight from Raycast's root search — the thing the per-repo Quicklinks
# used to do, minus creating them by hand.
#
# Edit REPOS below and re-run. Generated files are rewritten from scratch, so
# removing a repo here removes its script command too.

set -e

REPOS=(
  invideoio/iv-pro-timeline
  invideoio/iv-pro-web
  invideoio/iv-pro-copilot-v45
  invideoio/iv-pro-api
  invideoio/iv-pro-landing-pages
  invideoio/iv-pro-admin-web
  invideoio/iv-pro-payment-api
  invideoio/iv-pro-fx
  invideoio/iv-pro-media-router
  invideoio/iv-pro-model-router
  invideoio/iv-pro-scripts
  invideoio/iv-pro-export-worker
  rakshans1/dotfiles
)

SCRIPTS_DIR="$HOME/dotfiles/private/raycast/scripts"
PREFIX="repo-"

rm -f "$SCRIPTS_DIR/$PREFIX"*.sh

for full in "${REPOS[@]}"; do
  name="${full#*/}"
  file="$SCRIPTS_DIR/$PREFIX$name.sh"

  cat >"$file" <<EOF
#!/bin/bash

# Generated by bin/gen-raycast-repos — do not edit, edit the REPOS list there.

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title $name
# @raycast.mode silent

# Optional parameters:
# @raycast.icon 🐙
# @raycast.packageName GitHub
# @raycast.argument1 { "type": "text", "placeholder": "pulls | 1234 | issues", "optional": true }

# Documentation:
# @raycast.description Open $full in Chrome — blank for the repo, "pulls" for the PR list, a number for that PR
# @raycast.author rakshan
# @raycast.authorURL https://raycast.com/rakshan

exec "\$HOME/dotfiles/private/raycast/scripts/lib/open-repo.sh" "$full" "\$1"
EOF

  chmod +x "$file"
  echo "  $PREFIX$name.sh -> $full"
done

echo ""
echo "Generated ${#REPOS[@]} repo script commands in $SCRIPTS_DIR"
