#!/bin/bash
# Generate one Raycast script command per STARRED Crux Saved folder (group-*)
# and per STARRED Saved link (link-*), so each is reachable by name straight from Raycast's root search
# (an extension can't add root items; script commands can). Running one toggles
# the group: open it, focus it, or save & close it.
#
# Stars live in Crux (☆ on a Saved folder). Re-run after starring — the
# chrome-tabs Raycast extension's "Sync Starred Groups" command does it in the
# background. A profile whose Crux install is unreachable keeps its existing
# scripts instead of being wiped.

set -e
export PATH="$HOME/.nix-profile/bin:$HOME/dotfiles/bin:/usr/bin:/bin"

SCRIPTS_DIR="$HOME/dotfiles/private/raycast/scripts"
PREFIX="group-"
LINK_PREFIX="link-"

for profile in personal work; do
  if ! groups="$(rr chrome saved groups --starred --profile "$profile" 2>/dev/null)" \
    || ! echo "$groups" | jq -e 'type == "array"' >/dev/null 2>&1; then
    echo "  $profile: Crux unreachable, keeping existing scripts"
    continue
  fi

  rm -f "$SCRIPTS_DIR/$PREFIX$profile-"*.sh
  label="$(tr '[:lower:]' '[:upper:]' <<<"${profile:0:1}")${profile:1}"

  while IFS=$'\t' read -r id title path; do
    [ -z "$id" ] && continue
    slug="$(echo "$title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-|-$//g')"
    file="$SCRIPTS_DIR/$PREFIX$profile-${slug:-group}.sh"
    # Two starred folders with the same title: suffix with the folder id.
    [ -e "$file" ] && file="$SCRIPTS_DIR/$PREFIX$profile-${slug}-$(echo "$id" | tr -c 'a-z0-9' '-').sh"

    cat >"$file" <<SCRIPT
#!/bin/bash

# Generated by bin/gen-raycast-groups — do not edit; star/unstar the folder in Crux.

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title $title
# @raycast.mode silent

# Optional parameters:
# @raycast.icon 🗂️
# @raycast.packageName Tab Group · $label

# Documentation:
# @raycast.description Open or close the "$path" tab group ($label Chrome profile)
# @raycast.author rakshan
# @raycast.authorURL https://raycast.com/rakshan

exec "\$HOME/dotfiles/private/raycast/scripts/lib/toggle-group.sh" "$profile" "$id"
SCRIPT
    chmod +x "$file"
    echo "  $(basename "$file") -> $path ($profile)"
  done < <(echo "$groups" | jq -r '.[] | [.id, .title, .path] | @tsv')

  # Starred links. An older CLI without `saved links` leaves link files alone.
  if ! links="$(rr chrome saved links --starred --profile "$profile" 2>/dev/null)" \
    || ! echo "$links" | jq -e 'type == "array"' >/dev/null 2>&1; then
    echo "  $profile: no starred-links support/unreachable, keeping existing link scripts"
    continue
  fi

  rm -f "$SCRIPTS_DIR/$LINK_PREFIX$profile-"*.sh

  while IFS=$'\t' read -r id title url; do
    [ -z "$id" ] && continue
    [ -z "$title" ] && title="$url"
    slug="$(echo "$title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-|-$//g' | cut -c1-60 | sed -E 's/-$//')"
    file="$SCRIPTS_DIR/$LINK_PREFIX$profile-${slug:-link}.sh"
    # Two starred links with the same title: suffix with the link id.
    [ -e "$file" ] && file="$SCRIPTS_DIR/$LINK_PREFIX$profile-${slug:-link}-$(echo "$id" | tr -c 'a-z0-9' '-').sh"
    # Keep the header single-line.
    title="$(echo "$title" | tr -d '\r\n')"
    # Shell-safe single-quoted url for the exec line.
    qurl="'$(printf '%s' "$url" | sed "s/'/'\\\\''/g")'"

    cat >"$file" <<SCRIPT
#!/bin/bash

# Generated by bin/gen-raycast-groups — do not edit; star/unstar the link in Crux.

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title $title
# @raycast.mode silent

# Optional parameters:
# @raycast.icon 🔗
# @raycast.packageName Starred Link · $label

# Documentation:
# @raycast.description Open $url ($label Chrome profile)
# @raycast.author rakshan
# @raycast.authorURL https://raycast.com/rakshan

exec "\$HOME/dotfiles/private/raycast/scripts/lib/open-link.sh" "$profile" $qurl
SCRIPT
    chmod +x "$file"
    echo "  $(basename "$file") -> $url ($profile)"
  done < <(echo "$links" | jq -r '.[] | [.id, .title, .url] | @tsv')
done
