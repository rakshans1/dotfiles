#!/bin/bash
# Open (or focus) a URL in Chrome's focused window via the Crux extension.
#
# Replaces the old AppleScript "front window" version, which spanned all
# Chrome profiles and opened in the wrong window once spaces created several
# windows. Focuses a matching tab in the current window if one exists, else
# opens a new tab there, then brings Chrome forward. Routing through Crux also
# lets air-traffic-control rules auto-group the opened tab. Falls back to
# `open -a` if the bridge is unavailable. PATH pinned for Karabiner's minimal
# environment.

export PATH="/Users/rakshan/.nix-profile/bin:$HOME/dotfiles/bin:/usr/bin:/bin"

url="$1"
[ -z "$url" ] && { echo "usage: open-link <url>" >&2; exit 1; }

opened=false
existing=$(rr chrome list --current-window --fields id,url 2>/dev/null \
  | jq -r --arg u "$url" 'map(select(.url | contains($u)))[0].id // empty')

if [ -n "$existing" ]; then
  rr chrome focus "$existing" >/dev/null 2>&1 && opened=true
elif rr chrome open "$url" >/dev/null 2>&1; then
  opened=true
fi

if [ "$opened" = true ]; then
  /usr/bin/osascript -e 'tell application "Google Chrome" to activate' >/dev/null 2>&1
else
  /usr/bin/open -a "Google Chrome" "$url"
fi
